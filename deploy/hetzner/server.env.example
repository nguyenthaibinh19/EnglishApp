# File này nằm trên VPS, chế độ 600, không đưa cho người học.
# Chỉ cần key gọi AI. Không cần mật khẩu thoát khẩn cấp.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Phase 18B.1 vocabulary sync stays off until a later activation phase.
# Do not set STUDY_SYNC_ENABLED=1 on the VPS as part of shipping the source API.
# STUDY_SYNC_ENABLED=1
# STUDY_SYNC_DIR=
