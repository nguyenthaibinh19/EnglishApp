# Sao chép file này thành .env rồi điền key thật. File .env đã được .gitignore bỏ qua.

# Key chỉ nằm trên máy dev. Người học đăng nhập tài khoản, không nhận key này.
OPENAI_API_KEY=sk-...

# Máy dev gọi server ngay trên máy này.
# Khi người học dùng bản cài đặt, đổi thành https://ten-mien-cua-ban rồi đóng lại file exe.
ACCOUNT_SERVER_URL=http://127.0.0.1:8765

# Tùy chọn
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Số câu từ vựng đúng cần đạt mỗi lần mở máy
QUIZ_TARGET_CORRECT=5
DUTCH_LEVEL=A2
READING_WORD_COUNT=12
READING_PASSAGE_WORDS=220
READING_PASS_RATIO=0.8

# Đặt 0 khi đang sửa code để cửa sổ không fullscreen / không giữ focus
LOCK_SCREEN=1

# Mật khẩu để bấm “Thoát khẩn cấp”. Đổi thành mật khẩu riêng của bạn.
EMERGENCY_PASSWORD=oranje
