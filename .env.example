# Sao chép file này thành .env rồi điền key thật. File .env đã được .gitignore bỏ qua.

# Bắt buộc nếu muốn AI chấm câu và tự viết bài đọc
OPENAI_API_KEY=sk-...

# Tùy chọn
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Mục tiêu mỗi ngày
QUIZ_TARGET_CORRECT=30
DUTCH_LEVEL=A2
READING_WORD_COUNT=12
READING_PASSAGE_WORDS=220
READING_PASS_RATIO=0.8

# Đặt 0 khi đang sửa code để cửa sổ không fullscreen / không giữ focus
LOCK_SCREEN=1

# Mật khẩu để bấm “Thoát khẩn cấp”. Đổi thành mật khẩu riêng của bạn.
EMERGENCY_PASSWORD=oranje
